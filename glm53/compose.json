{
  "name": "glm53-joninco",
  "services": {
    "glm53": {
      "command": [
        "--quantization=modelopt_fp4",
        "--compilation-config={\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"custom_ops\":[\"all\"],\"max_cudagraph_capture_size\":256,\"pass_config\":{\"fuse_allreduce_rms\":true}}",
        "--ir-op-priority.rms_norm=vllm_c",
        "--ir-op-priority.fused_add_rms_norm=vllm_c",
        "--enable-flashinfer-autotune",
        "--default-chat-template-kwargs={\"reasoning_effort\":\"high\"}",
        "--enable-prompt-tokens-details",
        "--enable-force-include-usage",
        "--enable-request-id-headers"
      ],
      "environment": {
        "ATTENTION_BACKEND": "B12X",
        "B12X_DENSE_SPLITK_TURBO": "1",
        "B12X_MLA_SM120_UNIFIED": "1",
        "B12X_MOE_FORCE_A16": "1",
        "B12X_MOE_FORCE_A8": "0",
        "B12X_PCIE_DMA_FP8": "i8_ring",
        "B12X_PCIE_TP8_OWNER_REDUCE": "0",
        "B12X_W4A16_SMALL_M_HOST_BARRIER_RESET": "0",
        "B12X_W4A16_TC_DECODE": "1",
        "B12X_W4A8_TINY_DECODE": "1",
        "CUDA_DEVICE_MAX_CONNECTIONS": "32",
        "CUDA_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7",
        "CUTE_DSL_ARCH": "sm_120a",
        "DCP_COMM_BACKEND": "a2a",
        "DCP_SIZE": "1",
        "F8_DMA": "i8_ring",
        "GENERATION_CONFIG": "vllm",
        "GPU_MEMORY_UTILIZATION": "0.975",
        "HF_HUB_OFFLINE": "1",
        "HF_OVERRIDES": "{\"use_index_cache\":true,\"index_topk_pattern\":\"FFFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSS\"}",
        "INSTANTTENSOR_BACKEND": "BUFFERED",
        "LINEAR_BACKEND": "b12x",
        "LOAD_FORMAT": "instanttensor",
        "LONG_PREFILL_TOKEN_THRESHOLD": "0",
        "MAX_MODEL_LEN": "524288",
        "MAX_NUM_BATCHED_TOKENS": "8192",
        "MAX_NUM_SEQS": "64",
        "MODEL": "/models/GLM-5.3-NVFP4",
        "MOE_BACKEND": "b12x",
        "NCCL_IB_DISABLE": "1",
        "NCCL_P2P_LEVEL": "SYS",
        "NCCL_PROTO": "LL,LL128,Simple",
        "NUM_SPECULATIVE_TOKENS": "3",
        "OMP_NUM_THREADS": "1",
        "PORT": "${GLM53_PORT:-8000}",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHON_BIN": "/opt/venv/bin/python",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "SAFETENSORS_FAST_GPU": "1",
        "SERVED_MODEL_NAME": "GLM-5.3-NVFP4",
        "SPEC_CONFIG": "{\"method\":\"mtp\",\"num_speculative_tokens\":3,\"moe_backend\":\"triton\",\"attention_backend\":\"B12X\",\"draft_sample_method\":\"probabilistic\"}",
        "TP_SIZE": "8",
        "TRANSFORMERS_OFFLINE": "1",
        "VLLM_B12X_MOE_FP4_FORCE_A16": "1",
        "VLLM_CPP_AR_1STAGE_NCCL_CUTOFF": "56KB",
        "VLLM_CPP_AR_IGNORE_CUTOFF_MAX_ROWS": "0",
        "VLLM_DISABLE_SHARED_EXPERTS_STREAM": "0",
        "VLLM_ENABLE_PCIE_ALLREDUCE": "1",
        "VLLM_LM_HEAD_A16": "0",
        "VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS": "1",
        "VLLM_MEMORY_PROFILE_INCLUDE_ATTN": "1",
        "VLLM_MTP_NVFP4_LM_HEAD": "0",
        "VLLM_MXFP8_LM_HEAD": "0",
        "VLLM_NF3_GRID188_DECODE": "1",
        "VLLM_PCIE_ALLREDUCE_BACKEND": "b12x",
        "VLLM_PCIE_DMA_FP8": "i8_ring",
        "VLLM_PCIE_DMA_MIN_BYTES": "6MB",
        "VLLM_PCIE_ONESHOT_ALLREDUCE_MAX_SIZE": "64KB",
        "VLLM_PCIE_ONESHOT_FUSED_ADD_RMS_NORM_MAX_SIZE": "192KB",
        "VLLM_SHARED_EXPERTS_RETAIN_OUTPUT": "0",
        "VLLM_USE_AOT_COMPILE": "1",
        "VLLM_USE_B12X_FP8_GEMM": "1",
        "VLLM_USE_B12X_MHC": "1",
        "VLLM_USE_B12X_MOE": "1",
        "VLLM_USE_B12X_PCIE_DMA": "1",
        "VLLM_USE_B12X_SPARSE_INDEXER": "1",
        "VLLM_USE_B12X_WO_PROJECTION": "1",
        "VLLM_USE_BREAKABLE_CUDAGRAPH": "0",
        "VLLM_USE_FLASHINFER_SAMPLER": "1",
        "VLLM_USE_MEGA_AOT_ARTIFACT": "1",
        "VLLM_USE_STANDALONE_COMPILE": "1",
        "VLLM_USE_V2_MODEL_RUNNER": "1",
        "VLLM_WORKER_MULTIPROC_METHOD": "spawn"
      },
      "gpus": [
        {
          "count": -1
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS http://127.0.0.1:$${PORT:-8000}/health"
        ],
        "timeout": "10s",
        "interval": "30s",
        "retries": 10,
        "start_period": "20m0s"
      },
      "image": "${GLM53_IMAGE:-joninco/vllm@sha256:763f2bddf5d628d4f14267b44d646fb84d9251065b552132d7c38865ebccd037}",
      "init": true,
      "ipc": "host",
      "network_mode": "host",
      "privileged": true,
      "restart": "unless-stopped",
      "shm_size": "34359738368",
      "stop_grace_period": "2m0s",
      "ulimits": {
        "memlock": -1,
        "nofile": {
          "soft": 1048576,
          "hard": 1048576
        },
        "stack": 67108864
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${GLM53_MODEL_DIR:?Set GLM53_MODEL_DIR to the checkpoint directory}",
          "target": "/models/GLM-5.3-NVFP4",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "volume",
          "source": "compile-cache",
          "target": "/cache"
        },
        {
          "type": "volume",
          "source": "container-tmp",
          "target": "/container-tmp"
        }
      ]
    }
  },
  "volumes": {
    "compile-cache": {},
    "container-tmp": {}
  }
}
